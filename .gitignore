.aider*
.env

# Personal/identifiable data - real people's faces, visitor captures,
# attendance and detection history. Never committed, public or private
# repo - see .env.example for the config shape without real values.
known_faces/
unknown_faces/
captures/
attendance_exports/
logs/
faces.db
faces.db-journal

# Loose photo/video/audio artifacts from earlier prototyping - mostly
# captured people, not project assets.
*.jpg
*.jpeg
*.png
*.mp4
*.wav

# Standard pretrained YOLOv8n weights (~6.5MB, not project-specific) -
# download via: yolo settings, or python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
yolov8n.pt

# Unrelated bundled dependency (84MB, includes its own venv)
ai_coding_agent/

__pycache__/
*.pyc
